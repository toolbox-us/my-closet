# Copy to .env (git-ignored) and fill in your own key.
# Get a free key at https://aistudio.google.com/apikey
#
# These are NOT read automatically at runtime - Flutter has no dotenv here
# by design. They are passed on the command line via --dart-define.
# See README "Running with AI enabled".

GEMINI_API_KEY=your_key_here

# Image-capable model. Verify the current name at
# https://ai.google.dev/gemini-api/docs/models before a demo.
# The 2.5 family is access-limited to accounts that used it previously;
# new projects should use a 3.x Flash model.
GEMINI_MODEL=gemini-3.8-flash

# Only change if Google moves the endpoint again.
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions

# Optional. Leave empty to use the server default revision.
# Pin a date here if a future API change breaks the request shape.
GEMINI_API_REVISION=
